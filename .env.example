# ---------- Frontend (Vite, ต้องขึ้นต้น VITE_) ----------
VITE_LIFF_ID=2009830584-xxxxxxxx

# ---------- Vercel Python API (ตั้งใน Vercel > Settings > Environment Variables) ----------
LINE_CHANNEL_ACCESS_TOKEN=<Messaging API channel access token>
LINE_CHANNEL_SECRET=<Messaging API channel secret>
LIFF_CHANNEL_ID=2009830584
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key (secret!) จาก Supabase > Settings > API>

# เปิดตอน bootstrap: คนแรกที่ล็อกอินจะกลายเป็น owner อัตโนมัติ
# ตั้งเสร็จแล้วลบทิ้ง/ตั้งเป็น false
OPEN_SIGNUP=true

# ---------- Cron jobs (Vercel Cron หรือ Supabase pg_cron) ----------
# ตั้งค่านี้ใน Vercel env — ป้องกัน endpoint /api/cron/* ไม่ให้คนนอกเรียกได้
# ถ้าตั้งใน Vercel > Settings > Cron Jobs ด้วย ระบบจะแนบ Authorization: Bearer ให้อัตโนมัติ
CRON_SECRET=<random string เดา ยาว ๆ>

# (ตัวเลือก) เปิดใช้ /api/cron/enforce-richmenu — บังคับ user ที่เมนูหลุด ให้กลับไปเป็นเมนูนี้
# เว้นว่าง (default) = endpoint นี้จะไม่ทำอะไร (no-op ปลอดภัย)
ENFORCE_RICHMENU_ID=
# richMenuId ที่ยกเว้นไม่บังคับ คั่นด้วย , (เช่นเมนูแคมเปญ "สมัครติว" ที่ตั้งใจให้อยู่ต่อ)
ENFORCE_EXCLUDE_MENUS=

# ---------- Gemini AI auto-reply (ตัวเลือก) ----------
# ตอบคำถามอิสระอัตโนมัติ เฉพาะ user ที่ current rich menu ตรงชื่อ GEMINI_TRIGGER_MENU_NAME
# สมัคร API key ฟรีที่ https://aistudio.google.com/apikey — เว้นว่าง = ปิดฟีเจอร์นี้ทั้งหมด
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TRIGGER_MENU_NAME=แล้วพบกัน
# (ตั้งได้ต่อเมนูจากหน้าเว็บ Rich Menu ด้วย — ค่านี้เป็น fallback แบบเก่า)

# ---------- สลิปโอนเงิน (ตัวเลือก) ----------
# ตรวจสลิปอัตโนมัติด้วย EasySlip — เว้นว่าง = แจ้งแอดมินอย่างเดียว ไม่ตรวจ OCR
EASYSLIP_TOKEN=
# พอ user ส่งสลิปแล้ว เปลี่ยน rich menu ของ user คนนั้นเป็นเมนูนี้อัตโนมัติ (default = "แล้วพบกัน")
# เว้นว่าง = ปิด (ไม่เปลี่ยนเมนูอัตโนมัติหลังส่งสลิป)
SLIP_SUCCESS_RICHMENU_ID=richmenu-aa532223aad4fcd9d9878b219ad37714
